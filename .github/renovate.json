{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["helpers:pinGitHubActionDigests"],
  "enabledManagers": ["custom.regex", "github-actions", "pip_requirements"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^Dockerfile$"],
      "matchStrings": [
        "BUILD_FROM=(?<image>ghcr\\.io/home-assistant/base-python:(?<pythonVersion>[0-9\\.]+)-(?<alpineVersion>alpine[0-9\\.]+))-(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "home-assistant/docker-base"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["github-releases"],
      "matchDepNames": ["home-assistant/docker-base"],
      "groupName": "docker-base",
      "commitMessageTopic": "home-assistant/docker-base image",
      "commitMessageExtra": "to {{newVersion}}",
      "versioning": "pep440",
      "minimumReleaseAge": "1 hour"
    },
    {
      "description": "Label GitHub Actions updates like Dependabot did",
      "matchManagers": ["github-actions"],
      "labels": ["dependencies", "github_actions"]
    },
    {
      "description": "Leave runner labels and action version inputs alone, Dependabot never updated those",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["github-runner", "uses-with"],
      "enabled": false
    },
    {
      "description": "Our own actions that follow a branch (like home-assistant/actions@master) float on purpose. Pinning them would open a digest PR in every repository for each change to them. Our own actions on a version tag are pinned like any other.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["home-assistant/**"],
      "matchCurrentValue": "/^(dev|main|master)$/",
      "pinDigests": false
    },
    {
      "description": "Group the home-assistant/builder subactions into one PR (they share a release)",
      "matchPackageNames": ["/^home-assistant\\/builder(?:\\/|$)/"],
      "groupName": "home-assistant/builder",
      "groupSlug": "builder"
    },
    {
      "description": "Label Python requirement updates like Dependabot did",
      "matchManagers": ["pip_requirements"],
      "labels": ["dependencies", "python"]
    }
  ]
}
